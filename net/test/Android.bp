package {
    default_team: "trendy_team_fwk_core_networking",
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Main target used for VTS tests.
python_test {
    name: "vts_kernel_net_tests",
    stem: "kernel_net_tests_bin",
    srcs: [
        "*.py",
    ],
    libs: [
        "scapy",
    ],
    main: "all_tests.py",
    test_config: "vts_kernel_net_tests.xml",
    test_suites: [
        "vts",
        "general-tests",
        // See test/dts/README.md for triage instructions for bugs from the dts suite.
        // Bugs should not be filed on the core networking team.
        "dts",
    ],
}

// 32-bit variant of VTS kernel net tests for 32-bit ABI coverage in TEST_MAPPING.
python_test {
    name: "vts_kernel_net_tests_32",
    stem: "kernel_net_tests_bin_32",
    srcs: [
        "*.py",
    ],
    libs: [
        "scapy",
    ],
    main: "all_tests.py",
    test_config: "vts_kernel_net_tests_32.xml",
    test_suites: [
        "general-tests",
    ],
    compile_multilib: "32",
}

// Main target used for GKI tests.
// equivalent to above, but has 'gki.IS_GKI == True'
python_test {
    name: "gki_kernel_net_tests",
    stem: "kernel_net_tests_bin",
    srcs: [
        "*.py",
    ],
    libs: [
        "scapy",
    ],
    main: "all_tests_gki.py",
    test_config: "vts_kernel_net_tests.xml",
}
